<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Emitted by PyInstaller's bootloader and by libffi/ctypes closures:
         the hardened runtime blocks executable memory otherwise. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Qt plugins are dlopen()ed from Contents/Frameworks at runtime. Without
         this, hardened runtime's library validation rejects them. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
